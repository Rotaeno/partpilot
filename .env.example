# Documentation only: app reads process environment, never automatically loads this file.
PARTPILOT_MODE=demo
PARTPILOT_BUDGET_CNY=0
PARTPILOT_ENABLE_PAID_API=false
PARTPILOT_MAX_CALLS=50
PARTPILOT_MAX_OUTPUT_TOKENS=700
